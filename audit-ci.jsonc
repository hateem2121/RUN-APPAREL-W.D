{
  // Dependency vulnerability gate (audit-ci, Apache-2.0). Runs `pnpm audit` and
  // fails CI on HIGH or CRITICAL advisories; moderate/low are reported but do
  // not block. Run with: `pnpm exec audit-ci --config audit-ci.jsonc`.
  "high": true,
  "critical": true,
  "report-type": "important",
  // Continue past registry hiccups rather than flaking the build on a network
  // blip (a real advisory still fails the run).
  "retry-count": 3,
  // Allowlist specific advisories that are unfixable / not exploitable in this
  // context, with a dated justification, e.g. "GHSA-xxxx-xxxx-xxxx".
  //
  // Entries are PATH-SCOPED ("<advisory>|<dependency path>") on purpose: the
  // advisory stays blocking for any path not listed here, so if one of these
  // packages ever reaches runtime code the gate fails again instead of staying
  // silently suppressed. Re-check each entry when its parent package is bumped.
  // EMPTY, and worth keeping that way.
  //
  // Two GHSA-mh99-v99m-4gvg (brace-expansion DoS) paths lived here from
  // 2026-07-27, correctly: at the time the only patched release was 5.0.8, there
  // was no patched 1.x or 2.x, and v5 is a breaking API change that crashes
  // minimatch@3/@8. Both paths were build/CI-time only and unreachable by any
  // visitor, so suppressing them was the right call.
  //
  // Removed 2026-08-04. Upstream shipped 1.1.18 and 2.1.4, so the entries stopped
  // being "unfixable" and became "unfixed" — a different thing. They are now
  // pinned by `brace-expansion@1` / `@2` / `@5` overrides in package.json, and
  // audit-ci itself flagged the allowlist as redundant ("Consider not
  // allowlisting paths…"), which is the signal the header below asks for.
  //
  // The same pass fixed three more advisories that appeared between 2026-08-01
  // and 2026-08-04 — undici, fast-uri and ip-address — all by override rather
  // than suppression, because all three had patched versions available.
  "allowlist": []
}
