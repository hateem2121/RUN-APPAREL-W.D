{
  // Dependency vulnerability gate (audit-ci, Apache-2.0). Runs `pnpm audit` and
  // fails CI on HIGH or CRITICAL advisories; moderate/low are reported but do
  // not block. Run with: `pnpm exec audit-ci --config audit-ci.jsonc`.
  "high": true,
  "critical": true,
  "report-type": "important",
  // Continue past registry hiccups rather than flaking the build on a network
  // blip (a real advisory still fails the run).
  "retry-count": 3,
  // Allowlist specific advisories that are unfixable / not exploitable in this
  // context, with a dated justification, e.g. "GHSA-xxxx-xxxx-xxxx".
  //
  // Entries are PATH-SCOPED ("<advisory>|<dependency path>") on purpose: the
  // advisory stays blocking for any path not listed here, so if one of these
  // packages ever reaches runtime code the gate fails again instead of staying
  // silently suppressed. Re-check each entry when its parent package is bumped.
  "allowlist": [
    // GHSA-mh99-v99m-4gvg — brace-expansion DoS (unbounded expansion length,
    // CVSS 7.5). Added 2026-07-27. REVIEW BY 2026-10-27.
    //
    // Unfixable, not suppressed by choice: the only patched release is 5.0.8,
    // and there is no patched 1.x or 2.x. Both paths below resolve to
    // brace-expansion 1.1.16 / 2.1.2 through legacy glob@7 / glob@9, and v5 is
    // a breaking API change (v1 exports the function directly, v5 exports
    // `{ expand }`), so forcing it crashes minimatch@3/@8 and their consumers.
    // The one path that WAS on 5.x is genuinely fixed — see the
    // `brace-expansion@5` override in package.json.
    //
    // Not exploitable here: both remaining paths are build/CI-time only and are
    // never bundled into the deployed Worker. The DoS requires attacker-supplied
    // brace patterns reaching glob(); in both cases the patterns are fixed
    // internal strings, unreachable by any viewer visitor.
    //
    // Clears when @lhci/cli and @opennextjs/cloudflare bump their transitive
    // glob/rimraf. Drop the matching entry when that happens.

    // Lighthouse CI only (root devDependency; rimraf clearing its own temp dirs).
    "GHSA-mh99-v99m-4gvg|@lhci/cli>chrome-launcher>rimraf>glob>minimatch>brace-expansion",
    // Build-time minifier used during `opennextjs-cloudflare build`.
    "GHSA-mh99-v99m-4gvg|apps__cms>@opennextjs/cloudflare>@opennextjs/aws>@node-minify/core>glob>minimatch>brace-expansion"
  ]
}
