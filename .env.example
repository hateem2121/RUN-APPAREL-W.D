# ══════════════════════════════════════════════════════════════════════
# RUN APPAREL viewer system — environment variables
# Copy the relevant values into the places listed below. NEVER commit
# real secrets to git.
# ══════════════════════════════════════════════════════════════════════

# ── apps/viewer (Cloudflare Pages build settings, or apps/viewer/.env) ──

# Base URL of the CMS worker that serves the public viewer API.
VITE_API_BASE_URL=https://cms.wear-run.help

# Cloudflare Web Analytics beacon token for viewer.wear-run.help.
# Leave empty to disable analytics entirely (no cookies either way).
VITE_CF_BEACON_TOKEN=

# Optional Sentry DSN for client-side error tracking (free tier). Leave empty to
# disable — when unset the Sentry SDK is dead-code-eliminated from the bundle, so
# there is zero cost by default (verified: 0 files matching /sentry/ in dist).
# In CI this comes from the `VITE_SENTRY_DSN` repo VARIABLE; see ci.yml.
#
# Client errors are ALREADY captured without this, by apps/viewer/src/lib/telemetry.ts,
# which posts window.onerror + unhandledrejection to the CMS Events table. What
# Sentry adds is the STACK TRACE, the browser/OS, and grouping across visitors —
# telemetry.ts carries a message string only, capped at 5 per session.
VITE_SENTRY_DSN=
# VITE_SENTRY_RELEASE=      # release tag; CI sets the deploy commit SHA
# VITE_SENTRY_ENVIRONMENT=  # 'production' from CI; defaults to 'development'

# ── Sentry source-map upload (optional, deploy-time only) ──────────────────
# All THREE must be set or apps/viewer/vite.config.ts omits the upload plugin AND
# generates no source maps. That coupling is deliberate: dist/ is deployed
# wholesale, so a map that is generated but not uploaded-and-deleted would be
# served to the public internet. CI additionally hard-fails the deploy if any
# .map survives in dist/.
#
# SENTRY_AUTH_TOKEN is a SECRET (`gh secret set`), never a variable — it can write
# to the Sentry org. Scope it to `project:releases` only.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
#
# ⚠️ Two things Sentry cannot do from code, and that must be set in the Sentry
# PROJECT SETTINGS instead:
#   1. "Prevent Storing of IP Addresses" — ON. IP capture happens at Sentry's
#      ingestion edge; no SDK option suppresses it.
#   2. Session Replay — OFF. It records the DOM, which is the only thing here that
#      could capture something resembling a screenshot of a visitor's session.

# ── apps/cms (Cloudflare Worker) ───────────────────────────────────────
# Non-secret values live in apps/cms/wrangler.jsonc under "vars":
#   CMS_PUBLIC_URL            e.g. https://cms.wear-run.help
#   PUBLIC_MEDIA_BASE_URL     e.g. https://media.wear-run.help (R2 public/custom
#                             domain; empty = media served through the CMS)
#   VIEWER_ALLOWED_ORIGINS    comma-separated CORS origins for the public API
#   VIEWER_API_CACHE_SECONDS  edge cache lifetime for public API responses
#
# Non-secret email identity also lives in wrangler.jsonc "vars":
#   EMAIL_FROM_ADDRESS       e.g. noreply@wear-run.help (domain verified in Resend)
#   EMAIL_FROM_NAME          e.g. RUN APPAREL
#
# Secrets are set with wrangler, never in files:
#   npx wrangler secret put PAYLOAD_SECRET     (long random string, e.g. `openssl rand -hex 32`)
#   npx wrangler secret put RESEND_API_KEY     (from resend.com — enables password-reset/notification email)

# For local CMS development only (apps/cms/.env — used by `next dev`):
PAYLOAD_SECRET=generate-a-long-random-string

# ── apps/shrink (Cloudflare Worker + Container) ────────────────────────
# The auto-shrinker was absent from this file entirely, secrets included, so the
# only record of what it needs was comments inside apps/shrink/wrangler.jsonc.
#
# Non-secret values live in apps/shrink/wrangler.jsonc under "vars":
#   CMS_ORIGIN              origin the worker calls back on, e.g. https://cms.wear-run.help
#   R2_INGEST_S3_ENDPOINT   S3-compatible endpoint for the private ingest bucket
#   R2_INGEST_BUCKET        e.g. run-apparel-viewer-ingest
#
# Secrets are set with wrangler, never in files:
#   npx wrangler secret put CMS_ROBOT_API_KEY            (Payload API key for the robot user —
#                                                         sent as `Authorization: users API-Key <key>`)
#   npx wrangler secret put R2_INGEST_ACCESS_KEY_ID      (R2 S3 access key, ingest bucket)
#   npx wrangler secret put R2_INGEST_SECRET_ACCESS_KEY  (R2 S3 secret, ingest bucket)

# ── Operator tooling (your shell, for the scripts in scripts/) ─────────
# Read by scripts/find-orphan-media.mjs and `pnpm pipeline merge --from-cms`.
# CMS_URL=https://cms.wear-run.help
# CMS_API_KEY=                # Payload API key; same shape as CMS_ROBOT_API_KEY

# ── Local development only ─────────────────────────────────────────────
# PLAYWRIGHT_CHROMIUM_PATH=   # point at a Chromium when Playwright's own download
#                             # is absent (CI images, dev containers). Read by
#                             # apps/viewer/playwright.config.ts and the pipeline's
#                             # `render` command.
# PORT=                       # e2e fixture server / shrink container listen port
#
# PAYLOAD_LOCAL_D1, PAYLOAD_MIGRATE_REMOTE and PAYLOAD_MIGRATE_DOWN are set BY the
# npm scripts in apps/cms/package.json. Do not set them by hand.

# ── Seeding (optional overrides for `pnpm seed:cms`) ───────────────────
# SEED_ADMIN_EMAIL=admin@wear-run.help
# SEED_ADMIN_PASSWORD=change-me-immediately
# SEED_ASSETS_DIR=/absolute/path/to/tools/asset-pipeline/output
# SEED_DEV_ADMIN=1            # opt in to the known-password LOCAL dev admin.
#                             # Only `1` enables it; anything else is ignored.
