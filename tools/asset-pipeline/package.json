{
  "name": "@run-apparel/asset-pipeline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GLB asset pipeline: merges per-colourway CLO exports into one production GLB with KHR_materials_variants, validates variants against CMS variantIds, and generates placeholder seed assets",
  "bin": {
    "run-asset-pipeline": "./src/cli.ts"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsc --noEmit",
    "eval:artwork": "tsx scripts/eval-artwork-legibility.mjs",
    "eval:artwork:real": "tsx scripts/eval-artwork-real.mjs",
    "og:cards": "tsx scripts/og-cards.mjs",
    "strip:live": "tsx scripts/strip-live-r2.mts"
  },
  "dependencies": {
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/extensions": "4.4.2",
    "@gltf-transform/functions": "4.4.2",
    "draco3dgltf": "1.5.7",
    "gltf-validator": "2.0.0-dev.3.10",
    "ktx2-encoder": "0.6.0",
    "meshoptimizer": "1.2.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@google/model-viewer": "4.3.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "three": "0.183.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
