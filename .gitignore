# dependencies
node_modules/

# builds
dist/
build/
.next/
.open-next/
.wrangler/
*.tsbuildinfo

# env — never commit secrets
.env
.env.*
!.env.example
# wrangler's local override file — holds secrets and local-only vars, and does
# NOT match the .env.* patterns above.
.dev.vars
.dev.vars.*

# generated assets (reproducible via the asset pipeline)
tools/asset-pipeline/output/
output/

# raw CLO exports pulled from the R2 ingest bucket for local work. The N001
# export alone is 364 MB — fetch it with
#   wrangler r2 object get "run-apparel-viewer-ingest/<name>.glb" --file raw/<name>.glb --remote
# rather than committing it. Test fixtures derived from one belong in
# tools/asset-pipeline/src/__fixtures__/ and must be small enough to read in a
# diff (the wordmark alpha is 13 KB).
raw/

# local backups (D1 exports contain password hashes — never commit)
backups/

# test artifacts
playwright-report/
test-results/
.lighthouseci/

# codebase-memory-mcp index artifact (machine-local, rebuildable — see docs/AI-TOOLING.md)
.codebase-memory/

# misc
.DS_Store
*.log

# generated by apps/viewer/scripts/copy-decoders.mjs
apps/viewer/public/meshopt_decoder.js
apps/viewer/public/draco/
apps/viewer/public/basis/
