{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "viewer",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "pnpm@10.33.0", "--filter", "@run-apparel/viewer", "dev"],
      "port": 5173
    },
    {
      "name": "cms",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "pnpm@10.33.0", "--filter", "@run-apparel/cms", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "review",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "pnpm@10.33.0",
        "pipeline",
        "review",
        "output/review",
        "--port",
        "4180"
      ],
      "port": 4180
    },
    {
      "name": "cms-prod",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "PORT=3100 PAYLOAD_LOCAL_D1=1 NODE_ENV=production npx --yes pnpm@10.33.0 --filter @run-apparel/cms start"
      ],
      "port": 3100
    }
  ]
}
