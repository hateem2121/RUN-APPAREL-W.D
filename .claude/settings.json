{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm list:*)",
      "Bash(npx --yes pnpm@10.33.0 typecheck:*)",
      "Bash(npx --yes pnpm@10.33.0 test:*)",
      "Bash(npx --yes pnpm@10.33.0 build:*)",
      "Bash(npx --yes pnpm@10.33.0 -r test:*)",
      "Bash(npx --yes pnpm@10.33.0 -r typecheck:*)",
      "Bash(node --version)",
      "Bash(codebase-memory-mcp --version)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-pipeline-input.mjs\""
          }
        ]
      }
    ]
  }
}
