{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(npx --yes pnpm@10.33.0 typecheck:*)",
      "Bash(npx --yes pnpm@10.33.0 test:*)",
      "Bash(npx --yes pnpm@10.33.0 build:*)",
      "Bash(npx --yes pnpm@10.33.0 -r test:*)",
      "Bash(npx --yes pnpm@10.33.0 -r typecheck:*)",
      "Bash(npx --yes pnpm@10.33.0 eval:artwork:*)",
      "Bash(npx --yes pnpm@10.33.0 index:ai:*)",
      "Bash(npx --yes pnpm@10.33.0 seed:assets:*)",
      "Bash(node --version)",
      "Bash(codebase-memory-mcp --version)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(sudo rm:*)",
      "Bash(rm -rf raw:*)",
      "Bash(rm -rf ./raw:*)",
      "Bash(rm -rf tools/asset-pipeline/raw:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ],
    "ask": [
      "Bash(wrangler d1 delete:*)",
      "Bash(wrangler r2 bucket delete:*)",
      "Bash(wrangler r2 object delete:*)",
      "Bash(pnpm exec wrangler d1 delete:*)",
      "Bash(pnpm exec wrangler r2 bucket delete:*)",
      "Bash(pnpm exec wrangler r2 object delete:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-pipeline-input.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bare-pnpm.mjs\""
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "matcher": "session_start|nested_traversal|path_glob_match|include|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/log-instructions-loaded.mjs\""
          }
        ]
      }
    ]
  }
}
