{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // Formatter + linter for the whole repo. One tool rather than ESLint + Prettier
  // plus a plugin per framework: this is a five-package workspace maintained by
  // one person, and the failure mode of a linter setup here is that it rots and
  // gets switched off, not that it lacks a rule.
  //
  // THE FORMATTER SETTINGS ARE MEASURED FROM THE EXISTING CODE, not chosen.
  // Sampled across viewer, cms, pipeline, shrink and shared: no semicolons,
  // single-quoted imports, two-space indent. Matching what is already there keeps
  // the reformat commit small, which matters more than usual here — several of the
  // traps in CLAUDE.md are only discoverable from the comments beside the code, and
  // `git blame` is how you find the incident that motivated one. See
  // .git-blame-ignore-revs.
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.open-next",
      "!**/node_modules",
      "!**/output",
      "!**/test-results",
      "!**/playwright-report",
      "!**/*.min.js",
      // Self-hosted decoder binaries and the preview cards — vendored, not ours.
      "!apps/viewer/public",
      // Payload GENERATES both of these. Reformatting them guarantees a diff on
      // every regeneration, and migrations are the one place in this repo where an
      // unreviewed diff can delete data.
      "!apps/cms/src/migrations",
      "!apps/cms/src/payload-types.ts",
      // Next REWRITES this on every build, in its own style and with a different
      // import path for `next dev` vs `next build`. Formatting it means `pnpm
      // lint` fails after every single build.
      "!apps/cms/next-env.d.ts",
      // The 2026-08-30 audit evidence (~1.6 MB of generated JSON in
      // `docs/audit-2026-08-30`, ~2 MB of finding records in `docs/audit-2026-08-30-pm`)
      // used to be ignored here, because reformatting machine output rewrites every line
      // for no reader's benefit. Both folders are kept privately by the owner and are not
      // in this public repository (public since 2026-09-10), so the two ignore entries
      // matched nothing and were removed. If audit evidence is ever committed again, ignore
      // it here for the same reason.
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "json": {
    "formatter": { "enabled": true, "trailingCommas": "none" },
    "parser": { "allowComments": true }
  },
  // Biome 2.6 started formatting Markdown and YAML by default (measured 2026-10-24 on 2.6.2: 233
  // `.md` files, 14 workflows under .github/workflows and pnpm-workspace.yaml all "would have
  // printed" a different file, none of them touched by that bump). Neither is wanted here: the
  // docs are hand-written, and every CLAUDE.md, rule and doc is held to size and citation gates
  // that a reflow would shift; the workflows are parsed line by line by workflowHardening.test.ts
  // and diffed by the owner in review, so a whole-file reflow of ci.yml hides real changes. Left
  // off, `pnpm lint` checks exactly what it checked on 2.5.15.
  "markdown": { "formatter": { "enabled": false } },
  "yaml": { "formatter": { "enabled": false } },
  "linter": {
    "enabled": true,
    "rules": {
      // `"recommended": true` until Biome 2.5.8 deprecated it for `preset`, which
      // is the same rule set under a name that also accepts "all" / "none".
      "preset": "recommended",
      "style": {
        // `noUncheckedIndexedAccess` is on in tsconfig.base.json, so `arr[0]!` is
        // the idiom this codebase already uses to say "checked above". Banning it
        // would push people to `as` casts, which silence more.
        "noNonNullAssertion": "off"
      },
      // Three rules Biome 2.6.2 promoted into `recommended` fire on code that is right (59 rules
      // were promoted on 2026-10-21; measured here 2026-10-24, each hit read by hand). Off, not
      // suppressed per line, because the hits are the codebase's normal idiom.
      "correctness": {
        // Its idea of a valid `describe` is narrower than the two runners' own. Vitest takes
        // `describe('name', { timeout: 30_000 }, () => {…})` (apps/cms/src/shrinkImageMoved.test.ts,
        // 3 hits) and Playwright takes an untitled `test.describe(() => {…})` for a `test.use`
        // group (apps/viewer/e2e/hd-image.spec.ts) — and it reads a local helper named `describe`
        // inside a `page.evaluate` as a test group (apps/viewer/e2e/motion-and-layout.spec.ts,
        // 2 hits). 6 hits, 0 real.
        "usePlaywrightValidDescribeCallback": "off"
      },
      "performance": {
        // `innerText` is chosen on purpose in the browser tests and the copy check: it returns what
        // a visitor SEES (hidden and `display: none` text left out), which `textContent` does not.
        // 15 hits (11 in apps/cms/e2e, 2 in apps/viewer/e2e, 2 in scripts/copy-rules.mjs), 0 real.
        "useDomNodeTextContent": "off"
      },
      "complexity": {
        // The ternaries it wants as `Math.min`/`Math.max` are not the same function when the input
        // is NaN: `dt > 0 ? dt : 0` (apps/cms/src/lib/cursorMath.ts) is 0 for NaN, `Math.max(dt, 0)`
        // is NaN, and a NaN frame time would stop the cursor for good. The other three hits are
        // clamps with the same shape. 4 hits, none a safe rewrite without a test.
        "useMathMinMax": "off",
        "noForEach": "off",
        // Every occurrence is one of four things, counted 2026-10-23 across the CSS
        // files: (1) the `prefers-reduced-motion` block and (2) the Lenis override in
        // base.css, (3) the `.has-custom-cursor` rules in base.css (`cursor: none`, which
        // a list of per-element rules cannot keep up with), and (4) `@media print` blocks
        // (packages/ui/src/base.css, footer.css, footer-prompt.css, notch.css,
        // apps/viewer/src/styles/page.css, apps/cms/src/app/(frontend)/site.css), where
        // paper has to beat the screen rules. All need `!important` to do their job:
        // the reduced-motion recipe has to beat animation and inline styles, and
        // Lenis sets `scroll-behavior` on <html> itself. Turning these into
        // ordinary declarations would silently re-enable motion for people who
        // asked their operating system to switch it off.
        "noImportantStyles": "off"
      },
      "a11y": {
        // OFF AFTER READING ALL FIVE, not because a11y is unimportant here — it is
        // covered by axe-core across five e2e scenarios including failure states,
        // which is stronger evidence than this rule.
        //
        // The rule proposes `<output>` for `role="status"` and `<fieldset>` for
        // `role="group"`. Both are wrong in context: the four `role="status"` uses
        // are live regions announcing load and error state, not form output, and
        // the `role="group"` is the camera-position button row, not a form field
        // group. Taking the advice would attach form semantics to things that are
        // not forms — a downgrade a screen reader would actually notice.
        "useSemanticElements": "off"
      }
    }
  },
  // Import order is left alone deliberately: reordering imports across ~200 files
  // buys nothing and destroys blame on the first line of every one of them.
  "assist": { "actions": { "source": { "organizeImports": "off" } } },

  // ── MODULE BOUNDARIES ───────────────────────────────────────────────────────
  //
  // Every rule below states a property this repo ALREADY has — verified 2026-08-13,
  // all three are clean with no source changes — and the point is that nothing was
  // keeping them true. Each is a boundary whose violation typechecks, lints, tests
  // green, and fails at RUNTIME in a place far from the import.
  //
  // Test files are excluded throughout. They run in Node by definition, so
  // `node:fs` in a `.test.ts` is correct — apps/viewer/worker/preview.test.ts reads
  // index.html off disk to assert the rewritten tags still exist. The rule is about
  // SHIPPED code.
  "overrides": [
    {
      // Biome 2.6.2's `noInvalidGridAreas` miscounts a `grid-template-areas` written one string
      // per line, which is how these two files write all six of theirs, and calls valid grids
      // inconsistent. Planted control run both ways on 2026-10-24: `"intro" "main" "details"` on
      // three lines is flagged, `". figure" "copy figure"` on two lines is flagged, the same
      // strings on ONE line pass; every one of the six was read and has equal cell counts per
      // row. A `biome-ignore` comment above the declaration did not apply (reported as unused),
      // hence the per-file override. Remove it when a Biome release counts multi-line strings.
      "includes": ["apps/cms/src/app/(frontend)/site.css", "apps/viewer/src/styles/page.css"],
      "linter": { "rules": { "correctness": { "noInvalidGridAreas": "off" } } }
    },
    {
      // packages/shared is imported by three Workers and the pipeline. Its
      // tsconfig deliberately declares NEITHER @types/node NOR a `types` field, so
      // node globals cannot leak into Worker code — a property workflowHardening
      // .test.ts and claudeMd.test.ts both cite as the reason they live in apps/cms
      // instead. That protection is a type-level one: it stops you USING `process`,
      // but `import { readFile } from 'node:fs'` in a package with no node types is
      // an unresolved-module error only if the module is genuinely unresolvable,
      // and bundlers happily resolve it. This makes the intent enforceable.
      "includes": ["packages/shared/src/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["node:*", "fs", "path", "crypto", "os", "child_process"]
                  },
                  {
                    // The contract must not depend on its consumers. A cycle here
                    // would be invisible until a Worker bundle failed to build.
                    "group": ["@run-apparel/cms", "@run-apparel/viewer", "@run-apparel/shrink"]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // apps/shrink is a Cloudflare Worker. Node builtins do not exist in workerd:
      // an import that a bundler resolves at build time throws at runtime, inside a
      // queue consumer, where the symptom is a failed shrink job rather than a
      // module error. The container (apps/shrink/container/) is plain Node and is
      // deliberately NOT covered.
      "includes": ["apps/shrink/src/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [{ "group": ["node:*", "fs", "path", "crypto", "os", "child_process"] }]
              }
            }
          }
        }
      }
    },
    {
      // apps/viewer/src is browser code and apps/viewer/worker is a Worker. Neither
      // has Node. A `node:` import here survives `vite build` (Vite polyfills or
      // externalises depending on config) and breaks on a real phone — the device
      // this product is actually used on, via a QR scan, where nobody is watching a
      // console.
      "includes": [
        "apps/viewer/src/**",
        "apps/viewer/worker/**",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  { "group": ["node:*", "fs", "path", "crypto", "os", "child_process"] },
                  { "group": ["@run-apparel/cms", "@run-apparel/shrink"] }
                ]
              }
            }
          }
        }
      }
    },
    {
      // A spec that imports test/expect straight from @playwright/test skips
      // e2e/offlineMedia.ts's context.route() fixture and goes back to depending on
      // media.wear-run.help actually answering — which is exactly the bug measured
      // 2026-09-24 (a Cloudflare Islamabad-area stall hung page.goto('/products') at
      // 30s). Scoped to *.spec.ts only, so offlineMedia.ts itself (and any non-spec
      // e2e helper) keeps importing @playwright/test directly, which it must.
      "includes": ["apps/cms/e2e/**/*.spec.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@playwright/test": "Import test/expect from './offlineMedia' instead of '@playwright/test' — it fulfils media.wear-run.help requests locally so this suite cannot be blocked by a stall on that host (measured 2026-09-24). See apps/cms/e2e/offlineMedia.ts."
                }
              }
            }
          }
        }
      }
    }
  ]
}
