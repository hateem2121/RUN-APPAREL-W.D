{
  "name": "run-apparel-viewer-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "RUN APPAREL — QR-deep-linkable 3D apparel product viewer (viewer + Payload CMS + asset pipeline)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "esbuild",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "sharp": "0.35.3",
      "tmp": "^0.2.4",
      "postcss": "^8.5.22",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "brace-expansion@5": "^5.0.9",
      "undici": "^7.29.0",
      "fast-uri": "^3.1.5",
      "ip-address": "^10.3.1",
      "js-yaml@3": "^3.15.1",
      "js-yaml@4": "^4.3.1",
      "nanoid": "^3.3.18"
    },
    "patchedDependencies": {
      "@payloadcms/storage-r2@3.88.0": "patches/@payloadcms__storage-r2@3.88.0.patch"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage && node scripts/check-coverage.mjs --max-age-minutes 60",
    "dev:viewer": "pnpm --filter @run-apparel/viewer dev",
    "dev:cms": "pnpm --filter @run-apparel/cms dev",
    "pipeline": "pnpm --filter @run-apparel/asset-pipeline start",
    "seed:assets": "pnpm --filter @run-apparel/asset-pipeline start placeholders --out output/placeholders && pnpm --filter @run-apparel/asset-pipeline start merge --meshopt --out output/n001.glb output/placeholders/n001-navy.glb=N001-NAVY output/placeholders/n001-black.glb=N001-BLACK output/placeholders/n001-crimson.glb=N001-CRIMSON && pnpm --filter @run-apparel/asset-pipeline start validate output/n001.glb --expect N001-NAVY,N001-BLACK,N001-CRIMSON",
    "seed:cms": "pnpm --filter @run-apparel/cms seed",
    "index:ai": "node scripts/index-ai.mjs",
    "eval:artwork": "pnpm --filter @run-apparel/asset-pipeline eval:artwork",
    "eval:artwork:real": "pnpm --filter @run-apparel/asset-pipeline eval:artwork:real",
    "og:cards": "pnpm --filter @run-apparel/asset-pipeline og:cards"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@lhci/cli": "0.15.1",
    "audit-ci": "7.1.0"
  }
}
