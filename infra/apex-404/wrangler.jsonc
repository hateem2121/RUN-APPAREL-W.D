{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "run-apparel-apex-404",
  "main": "index.js",
  "compatibility_date": "2026-07-01",
  // Apex ONLY. This pattern does not match viewer./cms./media.wear-run.help —
  // those are distinct hostnames bound as Workers custom domains.
  "routes": [{ "pattern": "wear-run.help/*", "zone_name": "wear-run.help" }],
  "observability": { "enabled": true }
}
