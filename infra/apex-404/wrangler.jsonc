{
  // ⚠️ RECONCILED 2026-08-30 from the DEPLOYED Worker (`wrangler init --from-dash`).
  //
  // This file declared no bindings and only the apex route until then, while the
  // live Worker had both — so a `wrangler deploy` from here stripped the R2 binding
  // and 404'd both customer-facing PDFs, reporting success. See index.js.
  //
  // ⚠️ BOTH ROUTES ARE REAL. `www.wear-run.help/*` was live and undeclared here.
  // wrangler RECONCILES routes to this file, so removing either detaches the Worker
  // from that hostname. Confirmed against the deployed config, not inferred.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "run-apparel-apex-404",
  "main": "index.js",
  "compatibility_date": "2026-07-01",

  // Explicit rather than inferred from the presence of `routes`. Both are already
  // false on the deployed Worker; stating them means a future edit cannot quietly
  // open a second, unprotected hostname — which is exactly what `apps/cms` has.
  "workers_dev": false,
  "preview_urls": false,

  // Apex AND www. Neither pattern matches viewer./cms./media.wear-run.help — those
  // are distinct hostnames bound as Workers custom domains.
  "routes": [
    { "pattern": "wear-run.help/*", "zone_name": "wear-run.help" },
    { "pattern": "www.wear-run.help/*", "zone_name": "wear-run.help" }
  ],

  // ⚠️ SHARED BUCKET. `run-assets` is also bound by the separate `run-apparel`
  // commercial site's Worker. Two products, one bucket, and nothing written down
  // about who owns what — clearing "old files" from either side breaks the other.
  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "run-assets" }],

  "observability": { "enabled": true }
}
