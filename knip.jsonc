{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // BLOCKING since 2026-10-25 (owner decision, 24 Oct: "keep-clean checks, yes, after Wave 1").
  // It was report-only from 2026-10-01 and reported 0 findings on main on 25 Oct; now a pull
  // request that adds an unused file, export or package fails ci.yml's `verify`. Fix the finding,
  // or name the file below with WHO runs it — never silence it to go green.
  //
  // Every entry below is a file something OTHER than an import runs, which Knip cannot
  // see on its own: a person or a CI step runs `node scripts/x.mjs`, Claude Code runs the
  // hooks and skills, Playwright's config starts the e2e servers, and the shrink
  // container starts `container/server.ts`.
  //
  // An export used inside its own file is not dead code — only its `export` word is
  // unneeded. Counted 2026-10-01: 63 of 67 "unused exports" and 32 of 33 types were that.
  // Ignoring them leaves the report short enough that a new finding is noticed.
  "ignoreExportsUsedInFile": true,
  // Programs installed on the machine, not npm packages: Ghostscript renders the PDF
  // pages (document-pages.mjs); ffmpeg prepares the /products film from the owner's original
  // (build-products-film.mjs). chromedriver and safaridriver left this list on 2026-10-25: knip
  // reported both as no longer used once the phone scripts shared webdriver-client.mjs.
  "ignoreBinaries": ["gs", "ffmpeg"],
  // infra/apex-404 (the private-PDF-link Worker) has no package.json, so Knip cannot make it a
  // workspace ("a workspace must have a package.json", knip.dev/features/monorepos-and-workspaces,
  // read 2026-10-25). It needs none: the "." workspace's default project glob already covers it,
  // and the tests and scripts that import index.js reach the rest. Measured 2026-10-25 by planting
  // an unused file, an unused export in manifest.js and one in index.js: all three were reported.
  // ⚠️ Do NOT add infra/apex-404/index.js to an `entry` list "so Knip sees the Worker": an entry
  // file's exports are not reported, and the planted export in index.js then went unseen.
  "workspaces": {
    ".": {
      // ⚠️ NOT `scripts/*.mjs` (until 2026-10-25 it was): that made every script an entry, so a
      // script nothing runs could never show up, and an entry's unused exports are never reported.
      // Knip finds the scripts a workflow or package.json runs, and the ones a test or script
      // imports, by itself (measured 2026-10-25: all but the 13 below). These 13 are run BY HAND
      // or in a shape the workflow plugin does not read; each names where it is run. A NEW script
      // that nothing runs fails knip until it is listed here with its runner, or deleted.
      "entry": [
        ".claude/hooks/*.mjs",
        ".claude/skills/*/*.mjs",
        // uptime.yml runs it through a variable the GitHub Actions plugin does not resolve.
        "scripts/smoke-viewer-payload.mjs",
        // The deploy-and-live-checks skill and the runbook run it against a preview by hand.
        "scripts/smoke-viewer-preview.mjs",
        // Hand-run garment tools (`.claude/rules/cms-scripted-writes.md`, docs/RUNBOOK.md).
        "scripts/apply-customisation-copy.mjs",
        "scripts/attach-renders.mjs",
        "scripts/import-catalogue-products.mjs",
        "scripts/ingest-local-glb.mjs",
        "scripts/process-local.mjs",
        "scripts/publish-garment.mjs",
        "scripts/swap-live-model.mjs",
        "scripts/upload-posters.mjs",
        // Hand-run site tools: the /products film, the docs screenshots, the SEO crawl.
        "scripts/build-products-film.mjs",
        "scripts/capture-doc-screenshots.mjs",
        "scripts/seo-crawl.mjs"
      ],
      // Type declarations for the .mjs scripts, read by TypeScript, not imported.
      "ignore": ["scripts/*.d.mts"],
      // Deliberately NOT root dependencies (checked 2026-10-01: none resolves from the root).
      // sharp is loaded from tools/asset-pipeline through createRequire (it is native and
      // must not spread); capture-doc-screenshots.mjs loads Playwright from the app folder it
      // is run in; vitest.coverage.mjs names vitest/node only in a JSDoc type.
      // chrome-launcher: scripts/lighthouse-robot.mjs requires the copy Lighthouse installs,
      // on purpose — it must read the exact launch flags Lighthouse itself passes, so a
      // separately listed copy (another version) would measure the wrong browser (2026-10-23).
      "ignoreDependencies": ["sharp", "@playwright/test", "vitest", "chrome-launcher"]
    },
    "apps/cms": {
      "entry": [
        "e2e/*.mjs",
        "e2e/fixtures/*.entry.tsx",
        "open-next.config.ts",
        "scripts/*.mjs",
        "src/seed/*.ts"
      ],
      // A byte-for-byte mirror of apps/viewer/src/lib/camera-near-plane.ts, kept equal by
      // src/lib/render/viewerParity.test.ts, so it carries the viewer's exports too.
      "ignore": ["src/lib/render/camera-near-plane.ts"],
      // `server-only` is Next.js's own (next/dist/compiled/server-only). sharp is loaded by
      // the hand-run gen-icons.mjs from tools/asset-pipeline, deliberately not listed here.
      // @fontsource/ibm-plex-mono loads through CSS @font-face src url("@fontsource/…")
      // (src/app/(frontend)/site.css) and scripts/gen-share-images.mjs reads its file from
      // node_modules — real use knip's import analysis cannot see. Checked 2026-10-06: the
      // first cleanup attempt removed it from here on knip's word alone and would have broken both.
      // @fontsource-variable/archivo, the same way (checked 2026-10-23): no import since the
      // site serves its own cut (#214), but gen-share-images.mjs and calibrate-fallback.mjs
      // read its woff2 from node_modules, src/archivoCut.test.ts compares the cut against it,
      // and packages/ui/scripts/cut-archivo.py is cut from it.
      // `cloudflare` is the Workers RUNTIME, not an npm package: worker.mjs imports
      // `cloudflare:workers` (the shared page store, 2026-10-25), which knip reads as a package
      // named `cloudflare` and reported as unlisted once it blocked (measured on a trial merge).
      "ignoreDependencies": [
        "server-only",
        "sharp",
        "@fontsource/ibm-plex-mono",
        "@fontsource-variable/archivo",
        "cloudflare"
      ],
      // Loaded by a path string, not an import: e2e/productsGroupsHarness.ts aliases
      // `next/link` to it for the harness build. `ignoreFiles` drops it from "unused files"
      // only, so it is still analysed for everything else (knip.dev configuration reference).
      "ignoreFiles": ["e2e/fixtures/nextLinkShim.tsx"]
    },
    "apps/viewer": {
      "entry": ["scripts/*.mjs"],
      "ignore": ["scripts/*.d.mts"],
      // wrangler runs from the root (`pnpm --filter @run-apparel/viewer exec wrangler`, in
      // package.json and ci.yml). sharp is loaded by the hand-run gen-favicon.mjs from
      // tools/asset-pipeline and "must not become" a viewer dependency (that script says why).
      // @fontsource/ibm-plex-mono loads through CSS @font-face src url("@fontsource/…")
      // (src/styles/page.css, polish X5) — real use knip's import analysis cannot see.
      "ignoreDependencies": ["wrangler", "sharp", "@fontsource/ibm-plex-mono"]
    },
    "apps/shrink": {
      // The container is plain Node outside the pnpm workspace, with its own
      // package.json; its server is the entry. aws4fetch is declared at the root since
      // 2026-10-06 (the container and scripts/ingest-local-glb.mjs both use it), so it
      // resolves without an ignore entry here.
      "entry": ["container/server.ts"]
    },
    "tools/asset-pipeline": {
      "entry": ["scripts/*.mjs"]
    }
  }
}
