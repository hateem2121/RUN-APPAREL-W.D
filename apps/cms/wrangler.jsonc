{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deliberately NOT "run-apparel" — that worker is a separate, live RUN APPAREL
  // site. This viewer CMS is fully isolated. Never deploy over "run-apparel".
  "name": "run-apparel-viewer-cms",
  "main": ".open-next/worker.js",
  // RETIRED 2026-08-31. This was a TEMPORARY workers.dev URL opened so the viewer
  // could reach the CMS API while Bot Fight Mode was challenging cms.wear-run.help.
  // It was the last step of the API cutover, and BOTH conditions this comment set
  // for closing it are now met — each measured, not assumed:
  //
  //   1. VITE_API_BASE_URL = https://cms.wear-run.help (repo variable, set
  //      2026-08-30T16:12:33Z).
  //   2. The LIVE deployed bundle contains ZERO references to workers.dev —
  //      index.html and all four JS chunks. Control: the same grep finds
  //      'cms.wear-run.help' twice in the same chunk, so it is not a broken search.
  //   3. cms.wear-run.help answered /api/public/viewer/rxps/wine with 200 on four
  //      consecutive plain GETs.
  //
  // Why it mattered: while true, the whole CMS — including the /admin login —
  // answered on a hostname OUTSIDE the wear-run.help zone, so no zone rule, WAF
  // rule or rate limit applied to it. Narrowing the firewall rule protects
  // cms.wear-run.help; it could never protect this host.
  // Audit 2026-08-30 PM, findings L1-01, L4-01, L5-02, L18-04.
  //
  // ⚠️ Retiring this makes the workers.dev entry in the INGEST bucket's CORS
  // allow-list dead (finding L2-06). Remove it AFTER this deploy is verified, not
  // before — in that order a rollback never leaves the upload flow without an origin.
  "workers_dev": false,
  // Per-version preview URLs (…-run-apparel-viewer-cms.<sub>.workers.dev) would
  // expose /admin on ephemeral hosts; the viewer never uses them. Disabled.
  "preview_urls": false,
  /**
   * SMART PLACEMENT — run this Worker near D1, not near the visitor.
   *
   * ⚠️ MEASURED BEFORE CHANGING ANYTHING. Five consecutive plain GETs of
   * /api/public/viewer/rxps/wine on 2026-08-31: 2.041 / 1.991 / 2.849 / 1.943 /
   * 1.971 s to first byte, and NOT ONE carried a `cf-cache-status` header. The
   * viewer page on the same network in the same minute: 0.089 / 0.105 / 0.159 s
   * with `cf-cache-status: HIT`. So the delay is this Worker's own work, not the
   * network — every QR scan pays it.
   *
   * The `s-maxage=60` this endpoint sends is INERT and publicViewer.ts already says
   * so: a Worker's own response does not pass through the edge cache. So the edge
   * cannot be the fix here; the round trip to D1 is what there is to shorten.
   * `wrangler d1 info` puts the database in ENAM, and no placement was set on any
   * Worker in this repo.
   *
   * Cloudflare's own guidance is that this helps Workers making round trips to a
   * database and that fewer than 1% of Workers get slower. It takes up to 15
   * MINUTES after deploy to analyse traffic, so a measurement taken immediately
   * afterwards proves nothing either way — re-measure later, and if it has not
   * moved, delete these four lines rather than leaving a setting nobody can point
   * at a number for. Audit 2026-08-30 PM, findings L3-01 and L1-02.
   */
  "placement": { "mode": "smart" },
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs (free tier): worker errors + console output become queryable
  // in the Cloudflare dashboard and via `wrangler tail`.
  "observability": { "enabled": true },
  // Custom domain for this CMS worker. Cloudflare creates/manages the
  // cms.wear-run.help DNS record automatically (zone is on the same account).
  "routes": [{ "pattern": "cms.wear-run.help", "custom_domain": true }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "D1",
      // Isolated viewer database (schema already applied). NOT "run-apparel-db",
      // which belongs to the separate live site.
      "database_name": "run-apparel-viewer-db",
      "database_id": "41e20361-1a5f-4c87-b5ca-781c57c9b3f4"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      // Isolated viewer media bucket. NOT "run-assets"/"run-private" (the live site's).
      "bucket_name": "run-apparel-viewer-media"
    },
    {
      // PRIVATE ingest bucket for un-processed raw CLO uploads (the RawUploads
      // collection). Deliberately has NO custom domain and NO public access, so
      // a raw ~350 MB file can never be served to buyers.
      //
      // Lifecycle, re-verified against the live bucket on 2026-08-06 with
      // `wrangler r2 bucket lifecycle list run-apparel-viewer-ingest`:
      //
      //   expire-raw-uploads          Expire objects after 14 days        enabled
      //   Default Multipart Abort Rule  Abort incomplete multipart uploads after 7 days
      //
      // So raw ~350 MB exports no longer accumulate indefinitely. This comment has
      // now been wrong in BOTH directions — it asserted the 14-day expiry as fact
      // before one existed (corrected 2026-07-28), then asserted none existed after
      // one was added. Re-run the list command rather than trusting either the
      // comment or your memory; it takes five seconds and this is the third time.
      "binding": "R2_INGEST",
      "bucket_name": "run-apparel-viewer-ingest"
    }
  ],
  // Producer binding: a raw upload enqueues a shrink job. The consumer + the
  // Container that runs the asset pipeline live in the separate apps/shrink
  // Worker (kept out of this OpenNext Worker, which cannot host a Durable
  // Object / container class). Create the queue once: `wrangler queues create
  // glb-shrink`.
  "queues": {
    "producers": [
      {
        "binding": "SHRINK_QUEUE",
        "queue": "glb-shrink"
      }
    ]
  },
  "vars": {
    // Search engines. `hidden` = every public page carries noindex and the sitemap is
    // empty; ONLY the exact word `visible` opens the site. Absent also means hidden.
    // Owner decision 2026-09-06: a deploy-time switch, not an admin field. To launch
    // for real: change this to "visible", PR, merge. See src/lib/searchVisibility.ts.
    "SITE_INDEXING": "hidden",
    // Public URL of this CMS worker (used to absolutise media URLs when R2 public access is not configured).
    "CMS_PUBLIC_URL": "https://cms.wear-run.help",
    // Public base URL for R2 media. Media is served direct from R2 at
    // media.wear-run.help (R2 custom domain, Active) with a 30-day edge Cache
    // Rule and a bucket CORS policy allowing the viewer origins — browsers fetch
    // media direct from R2 with long-lived edge caching, bypassing the worker.
    // Set live 2026-07-22 (media half of the cutover). Empty here would revert to
    // streaming through the CMS worker — see docs/RUNBOOK.md → "API + media
    // domain cutover".
    "PUBLIC_MEDIA_BASE_URL": "https://media.wear-run.help",
    // Comma-separated origins allowed to call the public viewer API.
    // (run-apparel-viewer.pages.dev removed 2026-07-22 — the Pages project was
    // deleted after the viewer moved to the run-apparel-viewer-site Worker.)
    "VIEWER_ALLOWED_ORIGINS": "https://viewer.wear-run.help,http://localhost:5173",
    // Transactional email "From" identity (password resets / notifications). The
    // address's domain must be verified in Resend. The API key itself is a
    // secret: `wrangler secret put RESEND_API_KEY` — email is off until it is set.
    "EMAIL_FROM_ADDRESS": "noreply@wear-run.help",
    "EMAIL_FROM_NAME": "RUN APPAREL"
  }
  // Secrets (never in this file): wrangler secret put PAYLOAD_SECRET
  // Custom domain cms.wear-run.help is attached in the Cloudflare dashboard — see docs/CLOUDFLARE-SETUP.md
}
