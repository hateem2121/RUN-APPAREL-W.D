{
  "name": "@run-apparel/cms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RUN APPAREL private content administration (Payload CMS on Cloudflare Workers, D1 + R2)",
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --message \"${DEPLOY_MESSAGE:-manual}\"",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "migrate:create": "PAYLOAD_LOCAL_D1=1 payload migrate:create",
    "migrate": "PAYLOAD_LOCAL_D1=1 payload run src/seed/migrate.ts",
    "migrate:down": "PAYLOAD_LOCAL_D1=1 PAYLOAD_MIGRATE_DOWN=1 payload run src/seed/migrate.ts",
    "migrate:remote": "NODE_ENV=production PAYLOAD_LOCAL_D1=1 PAYLOAD_MIGRATE_REMOTE=1 payload run src/seed/migrate.ts",
    "migrate:remote:down": "NODE_ENV=production PAYLOAD_LOCAL_D1=1 PAYLOAD_MIGRATE_REMOTE=1 PAYLOAD_MIGRATE_DOWN=1 payload run src/seed/migrate.ts",
    "seed": "PAYLOAD_LOCAL_D1=1 SEED_DEV_ADMIN=1 payload run src/seed/run.ts",
    "test:e2e": "playwright test",
    "test:routes": "REQUIRE_BUILD_ARTIFACTS=1 vitest run src/hostRulesManifest.test.ts",
    "test:built-config": "REQUIRE_BUILD_ARTIFACTS=1 vitest run src/htmlLimitedBots.test.ts src/notFoundCsp.test.ts src/cspNonceMarker.test.ts src/cssDiscipline.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@opennextjs/cloudflare": "1.20.2",
    "@payloadcms/db-d1-sqlite": "3.90.1",
    "@payloadcms/email-resend": "3.90.1",
    "@payloadcms/next": "3.90.1",
    "@payloadcms/richtext-lexical": "3.90.1",
    "@payloadcms/storage-r2": "3.90.1",
    "@payloadcms/ui": "3.90.1",
    "@run-apparel/shared": "workspace:*",
    "@run-apparel/ui": "workspace:*",
    "graphql": "16.14.2",
    "next": "16.3.6",
    "payload": "3.90.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20260827.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-orm": "0.45.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.122.0"
  }
}
