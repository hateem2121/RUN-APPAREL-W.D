{
  "name": "@run-apparel/cms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RUN APPAREL private content administration (Payload CMS on Cloudflare Workers, D1 + R2)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "migrate:create": "PAYLOAD_LOCAL_D1=1 payload migrate:create",
    "migrate": "PAYLOAD_LOCAL_D1=1 payload run src/seed/migrate.ts",
    "migrate:down": "PAYLOAD_LOCAL_D1=1 PAYLOAD_MIGRATE_DOWN=1 payload run src/seed/migrate.ts",
    "migrate:remote": "NODE_ENV=production PAYLOAD_LOCAL_D1=1 PAYLOAD_MIGRATE_REMOTE=1 payload run src/seed/migrate.ts",
    "migrate:remote:down": "NODE_ENV=production PAYLOAD_LOCAL_D1=1 PAYLOAD_MIGRATE_REMOTE=1 PAYLOAD_MIGRATE_DOWN=1 payload run src/seed/migrate.ts",
    "seed": "PAYLOAD_LOCAL_D1=1 SEED_DEV_ADMIN=1 payload run src/seed/run.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@payloadcms/db-d1-sqlite": "3.86.0",
    "@payloadcms/email-resend": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/storage-r2": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "@run-apparel/shared": "workspace:*",
    "graphql": "16.14.2",
    "next": "16.2.12",
    "payload": "3.86.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260726.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  }
}
