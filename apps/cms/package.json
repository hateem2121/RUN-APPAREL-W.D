{
  "name": "@run-apparel/cms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RUN APPAREL private content administration (Payload CMS on Cloudflare Workers, D1 + R2)",
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --message \"${DEPLOY_MESSAGE:-manual}\"",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "migrate:create": "PAYLOAD_LOCAL_D1=1 payload migrate:create",
    "migrate": "PAYLOAD_LOCAL_D1=1 payload run src/seed/migrate.ts",
    "migrate:down": "PAYLOAD_LOCAL_D1=1 PAYLOAD_MIGRATE_DOWN=1 payload run src/seed/migrate.ts",
    "migrate:remote": "NODE_ENV=production PAYLOAD_LOCAL_D1=1 PAYLOAD_MIGRATE_REMOTE=1 payload run src/seed/migrate.ts",
    "migrate:remote:down": "NODE_ENV=production PAYLOAD_LOCAL_D1=1 PAYLOAD_MIGRATE_REMOTE=1 PAYLOAD_MIGRATE_DOWN=1 payload run src/seed/migrate.ts",
    "seed": "PAYLOAD_LOCAL_D1=1 SEED_DEV_ADMIN=1 payload run src/seed/run.ts",
    "test:e2e": "playwright test",
    "check:visuals": "node scripts/check-doc-visuals.mjs",
    "test:routes": "REQUIRE_BUILD_ARTIFACTS=1 vitest run src/hostRulesManifest.test.ts",
    "test:built-config": "REQUIRE_BUILD_ARTIFACTS=1 vitest run src/htmlLimitedBots.test.ts src/notFoundCsp.test.ts src/cspNonceMarker.test.ts src/cssDiscipline.test.ts src/servedCssMotionProbe.test.ts src/modelViewerQuiet.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@google/model-viewer": "4.3.1",
    "@number-flow/react": "0.6.2",
    "@opennextjs/cloudflare": "1.20.6",
    "@payloadcms/db-d1-sqlite": "3.90.2",
    "@payloadcms/email-resend": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-r2": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@run-apparel/shared": "workspace:*",
    "@run-apparel/ui": "workspace:*",
    "cobe": "2.0.1",
    "graphql": "16.14.2",
    "lenis": "1.3.26",
    "next": "16.3.6",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20260926.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.2",
    "drizzle-orm": "0.45.3",
    "libphonenumber-js": "1.13.14",
    "mermaid": "12.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.141.0"
  }
}
