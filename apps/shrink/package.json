{
  "name": "@run-apparel/shrink",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GLB shrink service: a queue-consumer Worker that drives a Cloudflare Container (Node + the asset pipeline) to shrink raw CLO uploads, then creates a guardrailed Media doc in the CMS via an internal service binding.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/puppeteer": "1.3.0",
    "@run-apparel/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260804.1",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.122.0"
  }
}
