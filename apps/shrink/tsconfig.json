{
  // EXTENDS THE BASE since 2026-08-12. It did not until then, and the drift was
  // invisible: this file restated most of the base's options by hand, so it looked
  // equivalent while quietly missing `noUncheckedIndexedAccess`,
  // `noImplicitOverride`, `noFallthroughCasesInSwitch` and `noImplicitReturns`.
  // Every other workspace had them. This is the Worker that drives the container
  // that processes every real garment — the least appropriate place in the
  // repository to be the one package checked less strictly than the rest.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // The ONE deliberate divergence, and it must stay. Setting `types` to
    // workers-types with no node types is what keeps node globals out of code the
    // Worker runs. It is also why nothing here may reach
    // tools/asset-pipeline/src/validate.ts, not even with `import type`: this is the
    // only package that resolves `readFile`'s Buffer against workers-types' own
    // definitions, so its readGlbGenerator fails here on every release from
    // 5.20260808.1, which held `@cloudflare/workers-types` at 5.20260804.1 until
    // 2026-10-03. container/report.ts imports from glb-report.ts instead, and
    // apps/cms/src/dependencyPolicy.test.ts fails if validate.ts is reached again.
    "types": ["@cloudflare/workers-types"],
    // Stricter than the base, enabled here 2026-08-13 — measured, it passes with
    // ZERO changes to source. See tsconfig.base.json for why it is per-package:
    // apps/cms and apps/viewer cannot pass it because Payload's and
    // @sentry/vite-plugin's own declarations write `?: T` while accepting an
    // explicit undefined.
    //
    // This package earns it for the same reason packages/shared does. It is the
    // Worker that decides whether a shrunk garment is written back onto a LIVE
    // product, and "the key is absent" vs "the key is present and undefined" is a
    // distinction it acts on — root CLAUDE.md records exactly that confusion
    // shipping decals on `alphaMode: BLEND`, via the `opaque` default mismatch
    // between `parseOptimizeArgs` (true) and `optimizeGlb` (absent → false).
    // Three of five workspaces are now on it; the two that are not are blocked
    // upstream, not by choice.
    "exactOptionalPropertyTypes": true
  },
  // The Worker, plus the container's pure report module, which src/
  // containerReport.test.ts covers — that ~10 KB of operator-facing text is what
  // every real garment produces and it had no tests at all.
  //
  // The second entry pulls in the pipeline's ambient declarations (draco3dgltf),
  // exactly as apps/shrink/container/tsconfig.json does. Without it, following
  // the report module's type imports reaches tools/asset-pipeline/src/io.ts and
  // fails on an untyped `draco3dgltf`. Declarations only — no pipeline
  // implementation is compiled into the Worker.
  "include": ["src/**/*.ts", "container/report.ts", "../../tools/asset-pipeline/src/**/*.d.ts"]
}
