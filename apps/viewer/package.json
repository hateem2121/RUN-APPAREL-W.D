{
  "name": "@run-apparel/viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RUN APPAREL public 3D product viewer — QR deep-linkable, Cloudflare Pages",
  "scripts": {
    "dev": "node scripts/copy-decoders.mjs && vite",
    "build": "node scripts/copy-decoders.mjs && NODE_ENV=production vite build && node scripts/gen-headers.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:preload": "REQUIRE_BUILD_ARTIFACTS=1 vitest run scripts/preload.test.ts",
    "test:e2e": "playwright test",
    "meshopt": "node scripts/copy-decoders.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@google/model-viewer": "4.3.1",
    "@run-apparel/shared": "workspace:*",
    "@run-apparel/ui": "workspace:*",
    "@sentry/browser": "11.8.0",
    "lenis": "1.3.27",
    "meshoptimizer": "1.3.0",
    "motion": "14.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261016.1",
    "@playwright/test": "1.64.0",
    "@sentry/vite-plugin": "5.4.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "30.1.3",
    "three": "0.183.2",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "wrangler": "4.148.0"
  }
}
