{
  "name": "@run-apparel/viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RUN APPAREL public 3D product viewer — QR deep-linkable, Cloudflare Pages",
  "scripts": {
    "dev": "node scripts/copy-decoders.mjs && vite",
    "build": "node scripts/copy-decoders.mjs && NODE_ENV=production vite build && node scripts/gen-headers.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:preload": "REQUIRE_BUILD_ARTIFACTS=1 vitest run scripts/preload.test.ts",
    "test:e2e": "playwright test",
    "meshopt": "node scripts/copy-decoders.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@google/model-viewer": "4.3.1",
    "@run-apparel/shared": "workspace:*",
    "@run-apparel/ui": "workspace:*",
    "@sentry/browser": "10.70.0",
    "lenis": "1.3.26",
    "meshoptimizer": "1.2.0",
    "motion": "13.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20260827.1",
    "@playwright/test": "1.62.1",
    "@sentry/vite-plugin": "5.4.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "5.0.1",
    "jsdom": "30.0.1",
    "three": "0.183.2",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "5.0.1",
    "wrangler": "4.137.0"
  }
}
